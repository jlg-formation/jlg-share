{
  "name": "jlg-share",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "APP_ORIGIN=http://localhost:5173 bun --watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests e2e scripts *.ts *.json *.yml .github/workflows deploy/Caddyfile --ignore-unknown",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json *.yml .github/workflows --ignore-unknown",
    "test": "bun test ./tests",
    "test:e2e": "bunx playwright test",
    "test:e2e:dev": "E2E_DEV_PROXY=1 bunx playwright test",
    "password": "bun scripts/password.ts"
  },
  "dependencies": {
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
