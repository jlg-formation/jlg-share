APP_DOMAIN=share.jlg-consulting.com
MEDIA_DOMAIN=media.jlg-consulting.com
ACME_EMAIL=your-address@example.com
# Single quotes are essential to preserve the dollar signs in an Argon2 hash.
ADMIN_PASSWORD_HASH='$argon2id$REPLACE_WITH_GENERATED_HASH'
# Generate distinct alphanumeric values, e.g. openssl rand -hex 16 / -hex 32.
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_RANDOM_SECRET
